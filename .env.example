# Copy to .env in the repository root. Used only by the backend at runtime.
# Empty credentials allow health and catalog search; live lots require both.
Stalcraft__ClientId=
Stalcraft__ClientSecret=

FRONTEND_PORT=8080

# Optional backend overrides (defaults match backend/appsettings.json):
# AllowedHosts=localhost;127.0.0.1
# Stalcraft__ApiBaseUrl=https://eapi.stalzone.com/
# Stalcraft__TokenUrl=https://exbo.net/oauth/token
# Stalcraft__Region=RU
# Stalcraft__RequestTimeoutSeconds=15
# Stalcraft__MinimumRequestIntervalMs=1000
# Stalcraft__CacheSeconds=10
# Stalcraft__ErrorCacheSeconds=2
# Stalcraft__MaxCachedPages=256
# Stalcraft__MaxPendingPages=16
